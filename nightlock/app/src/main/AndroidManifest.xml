<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay blocker for instant shielding of restricted apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Persistent enforcement service during sleep lock -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-engage lock immediately after tablet reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Exact bedtime and wake-up alarms even in Doze mode -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Allow discovering installed alarm clock apps so morning alarms always work -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.miui.clock" />
        <package android:name="com.oneplus.deskclock" />
        <package android:name="com.coloros.alarmclock" />
        <package android:name="com.lenovo.clock" />
    </queries>

    <application
        android:name=".NightLockApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_nightlock"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_nightlock"
        android:supportsRtl="true"
        android:theme="@style/Theme.NightLock"
        tools:targetApi="34">

        <!-- Daytime configuration & status dashboard -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NightLock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fullscreen dark sleep screen shown during lockdown (no undo button) -->
        <activity
            android:name=".ui.LockScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.NightLock.Fullscreen" />

        <!-- Accessibility service: blocks all apps, split-screen, and Settings while locked -->
        <service
            android:name=".service.SleepGuardAccessibilityService"
            android:directBootAware="true"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground service keeping the lock heartbeat & wake countdown alive overnight -->
        <service
            android:name=".service.SleepLockForegroundService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces user-configured bedtime device lockdown until morning wake time" />
        </service>

        <!-- Device Admin receiver: prevents uninstalling NightLock while Settings is blocked -->
        <receiver
            android:name=".receiver.SleepDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Exact alarm receiver for automatic bedtime lock & morning unlock -->
        <receiver
            android:name=".receiver.ScheduleAlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Re-engages lock after reboot or detects clock tampering -->
        <receiver
            android:name=".receiver.BootAndTimeReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
